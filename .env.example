# Neon PostgreSQL (connection string din dashboard-ul Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Clerk — chei din dashboard-ul Clerk (Developers -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# API Express
PORT=3001

# Originea permisă de CORS (frontend-ul). În dev = serverul Vite.
CORS_ORIGIN="http://localhost:5173"

# URL-ul API-ului pentru frontend.
# În dev lasă-l GOL (căile /api trec prin proxy-ul Vite).
# În producție = URL-ul backend-ului, ex: https://gym-connect-api.onrender.com
# VITE_API_URL=""
