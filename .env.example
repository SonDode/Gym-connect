# Neon PostgreSQL (Connection string din dashboard Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Secret pentru JWT (generează un string lung aleatoriu)
JWT_SECRET="schimba-acest-secret"

# API Express
PORT=3001

# Frontend (proxy Vite în dev)
VITE_API_URL="http://localhost:3001"
